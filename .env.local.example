# Copy to .env.local and fill in. Never commit .env.local.

# Needed for Live mode (Claude makes every decision). Scripted mode works without it.
ANTHROPIC_API_KEY=

# Optional overrides
# CARRYPAY_MODEL=claude-opus-5-5
# CARRYPAY_EFFORT=medium        # low | medium | high | xhigh | max
# CARRYPAY_STEP_DELAY_MS=700    # pacing for Replay/Scripted steps (video-friendly)
# CARRYPAY_DATA_DIR=.data       # where the world, ledger and recordings are stored
