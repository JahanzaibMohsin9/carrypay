# Copy to .env.local and fill in. Never commit .env.local.

# Live mode needs one LLM key. Scripted mode works without any.
# Planned default (adapter lands Oct 15): DeepSeek, with OpenAI as fallback.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# CARRYPAY_PROVIDER=deepseek     # deepseek | openai | anthropic (planned)

# Current code path (until the adapter lands) uses Claude:
ANTHROPIC_API_KEY=

# Optional overrides
# CARRYPAY_MODEL=deepseek-v4-pro
# CARRYPAY_EFFORT=medium        # low | medium | high | xhigh | max
# CARRYPAY_STEP_DELAY_MS=700    # pacing for Replay/Scripted steps (video-friendly)
# CARRYPAY_DATA_DIR=.data       # where the world, ledger and recordings are stored
