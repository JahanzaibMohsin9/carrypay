# Copy to .env.local and fill in. Never commit .env.local.

# Live mode needs one LLM key. Scripted mode works without any.
# Default: DeepSeek, with automatic fallback to OpenAI if DeepSeek errors.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# CARRYPAY_PROVIDER=deepseek     # deepseek | openai | anthropic
# ANTHROPIC_API_KEY=             # only if CARRYPAY_PROVIDER=anthropic

# Optional overrides
# CARRYPAY_MODEL=deepseek-v4-pro
# CARRYPAY_EFFORT=high          # DeepSeek: low | high | max · OpenAI: low | medium | high
# CARRYPAY_STEP_DELAY_MS=700    # pacing for Replay/Scripted steps (video-friendly)
# CARRYPAY_DATA_DIR=.data       # where the world, ledger and recordings are stored
